# Copy to .env on your server (Portainer environment variables)
# Do NOT commit this file with real values to git

# Gemini
GEMINI_API_KEY=paste-your-real-key-here
GEMINI_MODEL=gemini-3.6-flash

# Admin (CHANGE THESE!)
ADMIN_PASSWORD=use-a-strong-password-here
ADMIN_SECRET=generate-a-long-random-string-here-min-32-chars

# External port on the host (change if in use). Container always listens on 8000 internally.
HOST_PORT=8182
