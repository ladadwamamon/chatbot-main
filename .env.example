GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.6-flash
ADMIN_PASSWORD=change_this_password
ADMIN_SECRET=change-me-to-a-long-random-string
MANAGER_PASSWORD=change_this_manager_password
MANAGER_SECRET=change-me-manager-secret
# Hub (this server) public URL — customer kits use it as HUB_URL
HUB_PUBLIC_URL=https://manager.example.com
# Satellites only (customer VPS). Leave unset on the hub itself.
# HUB_URL=https://manager.example.com
